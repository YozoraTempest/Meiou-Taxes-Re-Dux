diff --git "a/C:\\Users\\Vulon\\AppData\\Local\\Temp\\redux-subject-selection-20260930\\empty" b/redux-tweak/common/scripted_triggers/ReduxSubjectSelection.txt
index e69de29..fe43f8c 100644
